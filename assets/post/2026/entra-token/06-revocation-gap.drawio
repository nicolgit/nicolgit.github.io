t="30.0" as="geometry" /></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:13.5px;color:#605E5C&quot;&gt;Revoking sessions stops the refresh token – not the access tokens already issued&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="50.0" width="1120.0" height="22.0" as="geometry" /></mxCell><mxCell id="c8" value="" style="html=1;rounded=0;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="82.0" as="sourcePoint" /><mxPoint x="1160.0" y="82.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#8A8886;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300.0" y="560.0" as="sourcePoint" /><mxPoint x="1150.0" y="560.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c10" value="&lt;span style=&quot;font-size:10.5px;color:#605E5C&quot;&gt;time&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="1100.0" y="566.0" width="60.0" height="20.0" as="geometry" /></mxCell><mxCell id="c11" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="318.0" y="548.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Token issued&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;e.g. 75-min lifetime&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="240.0" y="585.0" width="180.0" height="44.0" as="geometry" /></mxCell><mxCell id="c13" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D13438;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="498.0" y="548.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Token stolen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;malware, phishing…&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="420.0" y="585.0" width="180.0" height="44.0" as="geometry" /></mxCell><mxCell id="c15" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#8764B8;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="678.0" y="548.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;Admin reacts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;disable · reset · revoke&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="600.0" y="585.0" width="180.0" height="44.0" as="geometry" /></mxCell><mxCell id="c17" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="988.0" y="548.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;Access token expires&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;exp reached&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="910.0" y="585.0" width="180.0" height="44.0" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;Access token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#605E5C&quot;&gt;in client and attacker hands&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="130.0" width="270.0" height="50.0" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;Refresh token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#605E5C&quot;&gt;only ever sent to Entra ID&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="240.0" width="270.0" height="50.0" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b&gt;Your API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#605E5C&quot;&gt;offline validation, no CAE&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="350.0" width="270.0" height="50.0" as="geometry" /></mxCell><mxCell id="c22" value="legitimate use" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="330.0" y="140.0" width="180.0" height="32.0" as="geometry" /></mxCell><mxCell id="c23" value="attacker, undetected" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="510.0" y="140.0" width="180.0" height="32.0" as="geometry" /></mxCell><mxCell id="c24" value="revoked in Entra ID – still valid at the API" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#FDE7E9;strokeColor=#D13438;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="690.0" y="140.0" width="310.0" height="32.0" as="geometry" /></mxCell><mxCell id="c25" value="expired" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1000.0" y="140.0" width="150.0" height="32.0" as="geometry" /></mxCell><mxCell id="c26" value="valid" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="330.0" y="250.0" width="360.0" height="32.0" as="geometry" /></mxCell><mxCell id="c27" value="invalidated → next refresh fails → sign-in required" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#FDE7E9;strokeColor=#D13438;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="690.0" y="250.0" width="460.0" height="32.0" as="geometry" /></mxCell><mxCell id="c28" value="answers 200 OK to whoever presents the token" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="330.0" y="360.0" width="670.0" height="32.0" as="geometry" /></mxCell><mxCell id="c29" value="401" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;fontColor=#323130;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1000.0" y="360.0" width="150.0" height="32.0" as="geometry" /></mxCell><mxCell id="c30" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#986F0B;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="512.0" y="470.0" as="sourcePoint" /><mxPoint x="688.0" y="470.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c31" value="detection time" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="510.0" y="438.0" width="180.0" height="28.0" as="geometry" /></mxCell><mxCell id="c32" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#D13438;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="692.0" y="470.0" as="sourcePoint" /><mxPoint x="998.0" y="470.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;exposure window after revocation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;≈ remaining access-token lifetime (+ a few minutes)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="690.0" y="425.0" width="310.0" height="42.0" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;Levers to shrink the window&lt;/b&gt;&lt;br&gt;shorter access-token lifetime on sensitive APIs (down to 10 min) · faster detection · CAE on Microsoft resources" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="650.0" width="1120.0" height="70.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
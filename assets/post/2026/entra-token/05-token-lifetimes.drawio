=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="255.0" width="285.0" height="50.0" as="geometry" /></mxCell><mxCell id="c23" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;fillColor=#0078D4;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="758.9" y="269.0" width="25.7" height="22.0" as="geometry" /></mxCell><mxCell id="c24" value="20–28 h · revoked in near real time" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="796.7" y="265.0" width="400.0" height="30.0" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Refresh token – SPA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#605E5C&quot;&gt;fixed, not extended by use&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="325.0" width="285.0" height="50.0" as="geometry" /></mxCell><mxCell id="c26" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;fillColor=#A19F9D;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="767.4" y="339.0" width="10.6" height="22.0" as="geometry" /></mxCell><mxCell id="c27" value="24 h" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="790.0" y="335.0" width="400.0" height="30.0" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;Refresh token – other apps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#605E5C&quot;&gt;sliding: renewed at every use&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="395.0" width="285.0" height="50.0" as="geometry" /></mxCell><mxCell id="c29" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;fillColor=#A19F9D;strokeColor=#605E5C;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1107.7" y="409.0" width="18.2" height="22.0" as="geometry" /></mxCell><mxCell id="c30" value="90 days of inactivity · max age: until revoked" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=12.5;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="695.7" y="405.0" width="400.0" height="30.0" as="geometry" /></mxCell><mxCell id="c31" value="&lt;b&gt;Refresh and session token lifetimes are no longer configurable with token lifetime policies (retired January 2021).&lt;/b&gt;&lt;br&gt;To force users to sign in more often, use Conditional Access sign-in frequency." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="545.0" width="1120.0" height="85.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
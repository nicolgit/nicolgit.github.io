<mxfile host="app.diagrams.net"><diagram name="Putting it together: layered mitigations" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="830" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Putting it together: layered mitigations&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="18.0" width="1120.0" height="30.0" as="geometry" /></mxCell><mxCell id="c3" value="&lt;span style=&quot;font-size:13.5px;color:#605E5C&quot;&gt;Each layer shrinks the window – only the last one confirms every single operation&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="50.0" width="1120.0" height="22.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="html=1;rounded=0;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="82.0" as="sourcePoint" /><mxPoint x="1160.0" y="82.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;OIDC + OAuth 2.0 with Entra ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;MFA &amp;amp; Conditional Access at sign-in&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="105.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;every app and API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="105.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c7" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="129.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Segment APIs by risk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;standard vs critical app registrations&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="189.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;API design&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="189.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c10" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="213.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;10-minute lifetime on the critical API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;token lifetime policy assigned to that app only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#EFE6F7;strokeColor=#8764B8;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="273.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c12" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;critical API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="273.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c13" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="297.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;Authentication context step-up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;c2 → require MFA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#EFE6F7;strokeColor=#8764B8;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="357.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c15" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;critical operations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="357.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c16" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="381.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;Incident response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;disable user · reset password · revoke sessions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="441.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c18" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;compromised account&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="441.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c19" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="465.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;CAE where available&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;CAE-capable (cp1) clients&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="525.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c21" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;Microsoft 365 &amp;amp; Graph&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="525.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c22" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="549.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Per-transaction confirmation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;OTP / FIDO, implemented by the app&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FDE7E9;strokeColor=#D13438;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="90.0" y="609.0" width="680.0" height="72.0" as="geometry" /></mxCell><mxCell id="c24" value="&lt;span style=&quot;font-size:12.0px;color:#605E5C&quot;&gt;applies to&lt;/span&gt;&lt;br&gt;&lt;b&gt;“red button” operations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="785.0" y="609.0" width="375.0" height="72.0" as="geometry" /></mxCell><mxCell id="c25" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48.0" y="633.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;Residual risk for your own APIs&lt;/b&gt;&lt;br&gt;A stolen access token is usable until it expires: keep that window short where it matters,&lt;br&gt;and add an explicit confirmation where even a few minutes are too many." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="705.0" width="1120.0" height="95.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
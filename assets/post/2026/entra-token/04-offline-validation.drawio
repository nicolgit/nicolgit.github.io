<mxfile host="app.diagrams.net"><diagram name="Offline token validation" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="765" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Offline token validation&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="18.0" width="1120.0" height="30.0" as="geometry" /></mxCell><mxCell id="c3" value="&lt;span style=&quot;font-size:13.5px;color:#605E5C&quot;&gt;The API trusts Entra ID's signature – it doesn't call Entra ID on each request&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="50.0" width="1120.0" height="22.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="html=1;rounded=0;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="82.0" as="sourcePoint" /><mxPoint x="1160.0" y="82.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="105.0" width="440.0" height="235.0" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="112.0" width="440.0" height="30.0" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;JWKS endpoint – public keys&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;/.well-known/openid-configuration → jwks_uri&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="80.0" y="150.0" width="400.0" height="75.0" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Private signing key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;never leaves Entra ID · signs every token (RS256)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="80.0" y="245.0" width="400.0" height="75.0" as="geometry" /></mxCell><mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="700.0" y="105.0" width="440.0" height="235.0" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Web API (resource)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="700.0" y="112.0" width="440.0" height="30.0" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b&gt;Cached public keys&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;refreshed periodically (≈ daily) and on key rollover&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="720.0" y="150.0" width="400.0" height="75.0" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b&gt;Token validation middleware&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;e.g. Microsoft.Identity.Web or a JWT library&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="720.0" y="245.0" width="400.0" height="75.0" as="geometry" /></mxCell><mxCell id="c13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#323130;strokeWidth=1.6;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="188.0" as="sourcePoint" /><mxPoint x="718.0" y="188.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c14" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="491.0" y="176.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c15" value="download keys&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#605E5C&quot;&gt;async · not per request&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="515.0" y="140.0" width="185.0" height="42.0" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;Client app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#605E5C&quot;&gt;holds the access token&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;fontColor=#323130;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="420.0" width="300.0" height="90.0" as="geometry" /></mxCell><mxCell id="c17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#323130;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360.0" y="465.0" as="sourcePoint" /><mxPoint x="718.0" y="283.0" as="targetPoint" /><Array as="points"><mxPoint x="640.0" y="465.0" /><mxPoint x="640.0" y="283.0" /></Array></mxGeometry></mxCell><mxCell id="c18" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="372.0" y="453.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c19" value="GET /api/orders&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;Authorization: Bearer eyJ…&lt;/font&gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="400.0" y="415.0" width="235.0" height="44.0" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;Local checks – no call to Entra ID&lt;/b&gt;&lt;br&gt;signature (kid → public key) · iss · aud&lt;br&gt;exp / nbf · scp / roles&amp;nbsp; →&amp;nbsp; 200 OK or 401" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="700.0" y="365.0" width="440.0" height="80.0" as="geometry" /></mxCell><mxCell id="c21" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="688.0" y="353.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c22" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="545.0" width="1080.0" height="185.0" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Access token (JWT)&amp;nbsp; =&amp;nbsp; header&amp;nbsp; .&amp;nbsp; payload&amp;nbsp; .&amp;nbsp; signature&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="80.0" y="555.0" width="1040.0" height="30.0" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;Header&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;alg: RS256&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;kid: &amp;lt;signing key id&amp;gt;&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="80.0" y="600.0" width="300.0" height="110.0" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Payload – claims (readable by anyone)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;iss · aud · exp · nbf · tid&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;oid · name · roles · scp · acrs&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="400.0" y="600.0" width="420.0" height="110.0" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;Signature&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;created with Entra's private key&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;verified with its public key&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840.0" y="600.0" width="280.0" height="110.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
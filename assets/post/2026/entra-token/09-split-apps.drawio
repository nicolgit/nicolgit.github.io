<mxfile host="app.diagrams.net"><diagram name="Different risk, different token lifetime" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="&lt;b&gt;Different risk, different token lifetime&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="18.0" width="1120.0" height="30.0" as="geometry" /></mxCell><mxCell id="c3" value="&lt;span style=&quot;font-size:13.5px;color:#605E5C&quot;&gt;Split critical operations into a separate app registration&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="50.0" width="1120.0" height="22.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="html=1;rounded=0;endArrow=none;endFill=1;startArrow=none;startFill=1;strokeColor=#0078D4;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="82.0" as="sourcePoint" /><mxPoint x="1160.0" y="82.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;Client app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#605E5C&quot;&gt;SPA / web app + MSAL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#F3F2F1;strokeColor=#8A8886;strokeWidth=1.5;fontColor=#323130;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="330.0" width="240.0" height="110.0" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#605E5C&quot;&gt;one access token per API (aud)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DEECF9;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#323130;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="430.0" y="110.0" width="340.0" height="100.0" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;App registration A – Orders API&lt;/b&gt;&lt;br&gt;standard operations&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /orders · /list · /read&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="235.0" width="340.0" height="200.0" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Token lifetime: default (60–90 min)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px;color:#605E5C&quot;&gt;or a policy, e.g. 60 min&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#EFE6F7;strokeColor=#8764B8;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840.0" y="340.0" width="300.0" height="78.0" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;App registration B – Payments API&lt;/b&gt;&lt;br&gt;critical operations&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;POST /transfers/execute&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820.0" y="470.0" width="340.0" height="240.0" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Token lifetime policy: 10 min&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;AccessTokenLifetime = 00:10:00&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;+ auth context c2 → MFA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#EFE6F7;strokeColor=#8764B8;strokeWidth=1.5;fontColor=#323130;fontSize=12.5;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="840.0" y="575.0" width="300.0" height="115.0" as="geometry" /></mxCell><mxCell id="c11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#323130;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160.0" y="328.0" as="sourcePoint" /><mxPoint x="428.0" y="160.0" as="targetPoint" /><Array as="points"><mxPoint x="160.0" y="160.0" /></Array></mxGeometry></mxCell><mxCell id="c12" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="148.0" y="288.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c13" value="token per API&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#605E5C&quot;&gt;AT-A ≈ 60–90 min · AT-B = 10 min&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="175.0" y="105.0" width="250.0" height="48.0" as="geometry" /></mxCell><mxCell id="c14" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#323130;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280.0" y="372.0" as="sourcePoint" /><mxPoint x="818.0" y="372.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c15" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="292.0" y="360.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-size:10.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;Bearer AT-A&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#605E5C&quot;&gt;aud = Orders API&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="330.0" y="325.0" width="280.0" height="44.0" as="geometry" /></mxCell><mxCell id="c17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#323130;strokeWidth=1.6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280.0" y="412.0" as="sourcePoint" /><mxPoint x="818.0" y="600.0" as="targetPoint" /><Array as="points"><mxPoint x="560.0" y="412.0" /><mxPoint x="560.0" y="600.0" /></Array></mxGeometry></mxCell><mxCell id="c18" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="292.0" y="400.0" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c19" value="&lt;span style=&quot;font-size:10.5px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;Bearer AT-B&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#605E5C&quot;&gt;aud = Payments API&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#323130;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="575.0" y="553.0" width="235.0" height="44.0" as="geometry" /></mxCell><mxCell id="c20" value="Policies are assigned to the API (resource) app registration or service principal and are managed with Microsoft Graph / PowerShell.&lt;br&gt;&lt;b&gt;An organization-level default policy takes precedence over app-level policies – check before relying on per-app values.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFF4CE;strokeColor=#986F0B;strokeWidth=1.5;fontColor=#323130;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="745.0" width="1120.0" height="90.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>